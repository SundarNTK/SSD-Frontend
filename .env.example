# Port sequence across every SSD repo: 5001 admin-frontend, 5002 pos-frontend,
# 5003 User-Service, 5004 Catalog-Service, 5005 notification-worker,
# 5006 local-print-agent, 5007 customer-frontend.
#
# Absolute, not relative: unlike the old Vite app, there's no dev-server
# proxy here — the browser calls these origins directly (CORS is already
# configured on the API side for this).
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:5003/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5004/api/v1
