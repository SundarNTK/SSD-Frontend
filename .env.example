# SSD-Backend is the merged Auth/Users/Roles/Customers/Masters/POS/Inventory/
# Payments/Reports API (formerly User-Service + Catalog-Service +
# Payment-Service + Notification-Service, four separate ports) — one origin
# for everything now, on the port sequence's old User-Service slot (5003).
#
# Absolute, not relative: unlike the old Vite app, there's no dev-server
# proxy here — the browser calls this origin directly (CORS is already
# configured on the API side for this). Both vars point at the same origin;
# kept as two names since call sites already distinguish authApi/api and a
# real reason to split traffic could come back later.
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:5003/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:5003/api/v1

# On Vercel, set both of these (Project Settings > Environment Variables)
# to the deployed SSD-Backend origin instead, e.g.
# https://ssd-backend.onrender.com/api/v1 — and make sure that same origin
# is in SSD-Backend's CORS_ORIGIN.
